# FairShare — Firebase web config TEMPLATE (safe to commit).
# Copy this file to `.env` and fill in your own project's values from
# Firebase Console → Project settings → Your apps → web app config.
#
# Note: these web keys are NOT secret (they ship in the client bundle). Env vars
# just keep them out of source control. Real access control = Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — only for Google Analytics (looks like G-XXXXXXX).
VITE_FIREBASE_MEASUREMENT_ID=

# Optional — turn on the AI-polished fairness summary on the report page.
# Set to `on` ONLY after enabling Firebase AI Logic (Gemini Developer API) in the
# console. Left blank/off, the report shows the rule-based summary and the
# "Polish with AI" button never appears — nothing else changes.
VITE_AI_SUMMARY=
